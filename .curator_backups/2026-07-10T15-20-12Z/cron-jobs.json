      "id": "88ab7ff66681",
      "name": "\u98de\u4e66\u6bcf\u65e5\u6458\u8981-\u5176\u4ed6\u4eba\u5bf9\u8bdd",
      "prompt": "\u4f60\u662f\u98de\u4e66\u5bf9\u8bdd\u6458\u8981\u673a\u5668\u4eba\u3002\u6267\u884c\u4ee5\u4e0b\u6b65\u9aa4\uff08\u4e25\u683c\u6309\u987a\u5e8f\uff0c\u4e0d\u8981\u505a\u4efb\u4f55\u4e0e\u4efb\u52a1\u65e0\u5173\u7684\u64cd\u4f5c\u5982\u6e05\u7406\u6587\u4ef6\uff09\uff1a\n\n**\u6b65\u9aa41**\uff1a\u7528 terminal \u6267\u884c\u6b64 Python \u811a\u672c\u67e5\u8be2\u8fc7\u53bb24\u5c0f\u65f6\u5185\u975e\u5996\u7389\u7684\u98de\u4e66\u4f1a\u8bdd\uff1a\n\n```python\nimport sqlite3, json, datetime\ndb = sqlite3.connect('C:/Users/HMSJ/AppData/Local/hermes/state.db')\ncur = db.cursor()\nsince = datetime.datetime.now().timestamp() - 86400\n\ncur.execute('''\nSELECT id, user_id, chat_type, title, started_at, message_count\nFROM sessions\nWHERE source LIKE '%feishu%'\n  AND user_id != 'ou_7288c4a018284580d463d0239cbd47cf'\n  AND started_at > ?\nORDER BY started_at DESC\n''', (since,))\n\nsessions = []\nfor row in cur.fetchall():\n    sid, user_id, chat_type, title, started_at, msg_count = row\n    cur.execute('SELECT content FROM messages WHERE session_id=? AND role=\"user\" LIMIT 5', (sid,))\n    msgs = [r[0][:200] for r in cur.fetchall()]\n    sessions.append({\n        'session_id': sid,\n        'user_id': user_id,\n        'chat_type': chat_type,\n        'title': title,\n        'msg_count': msg_count,\n        'preview': msgs\n    })\n\nif not sessions:\n    print(\"NO_SESSIONS\")\nelse:\n    print(json.dumps(sessions, ensure_ascii=False, indent=2))\n```\n\n**\u6b65\u9aa42**\uff1a\u5982\u679c\u8f93\u51fa\u662f `NO_SESSIONS`\uff0c\u76f4\u63a5\u56de\u590d\u300c\u4eca\u65e5\u65e0\u5176\u4ed6\u7528\u6237\u5bf9\u8bdd\u300d\u3002\u8df3\u8fc7\u6b65\u9aa43-4\u3002\n\n**\u6b65\u9aa43**\uff1a\u5bf9\u6bcf\u4e2a\u4f1a\u8bdd\u7528 session_search(session_id=\"...\") \u8bfb\u53d6\u5b8c\u6574\u5bf9\u8bdd\u3002\n\n**\u6b65\u9aa44**\uff1a\u6309\u4e3b\u9898\u5f52\u7c7b\u6458\u8981+\u5efa\u8bae\u3002\u4e25\u683c\u7528\u6b64\u683c\u5f0f\u8f93\u51fa\uff08\u4e0d\u8981\u52a0\u4e